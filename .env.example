# ===========================================
# AAKSHI E-commerce Platform - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/aakshi?schema=public"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Admin Credentials (used during seed)
ADMIN_PASSWORD="Aakshi@Admin2024!"

# API Server
API_PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# Next.js Frontend
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-change-in-production"

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook OAuth (Optional)
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Razorpay Payments
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Stripe Payments
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Cloudinary (Image/Video Storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (Email)
RESEND_API_KEY=""
EMAIL_FROM="AAKSHI <noreply@aakshi.com>"

# Algolia Search (Optional)
ALGOLIA_APP_ID=""
ALGOLIA_ADMIN_API_KEY=""
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=""
NEXT_PUBLIC_ALGOLIA_INDEX="aakshi_products"

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Microsoft Clarity
NEXT_PUBLIC_CLARITY_PROJECT_ID=""

# WhatsApp Business
WHATSAPP_NUMBER="+919876543210"
